{
  "title": "Prozess Bestellanforderung (BANF)",
  "process_id": "VXI-VP-BANF",
  "steps": [
    { "type": "start", "text": "Bedarf entsteht" },

    { "n": "1", "type": "activity",
      "text": "BANF im Portal erfassen (Positionen, Kostenstelle, Lieferant, Angebot)",
      "input": "BANF-Portal (SharePoint / Teams), Angebot",
      "R": "Antragsteller",
      "output": "BANF-Entwurf" },

    { "n": "2", "type": "activity",
      "text": "Summen prüfen und Freigabeweg ermitteln",
      "input": "Freigaberegeln: Kostenstelle; ab 5.000 € Bereichsleitung; ab 25.000 € Geschäftsführung; Vertretungen",
      "R": "Workflow", "I": "Antragsteller",
      "output": "BANF-Nr., Freigabeweg" },

    { "n": "3", "type": "activity",
      "text": "Freigabe der nächsten Stufe anfordern",
      "input": "Teams-App Genehmigungen, Outlook",
      "R": "Workflow", "A": "Freigeber" },

    { "n": "4", "type": "decision", "text": "Genehmigt?",
      "R": "Freigeber", "durchgang_label": "Ja",
      "routes": [ { "label": "Nein", "to": "abl" } ],
      "output": "Freigabeverlauf" },
    { "n": "abl", "type": "subprocess", "lane": "rechts",
      "text": "Ablehnung, Mail an Antragsteller" },

    { "n": "5", "type": "decision", "text": "Weitere Stufe nötig?",
      "R": "Workflow", "durchgang_label": "Nein",
      "routes": [ { "label": "Ja", "to": "3" } ] },

    { "n": "6", "type": "activity",
      "text": "BANF freigeben und als Datensatz sperren",
      "input": "Purview-Aufbewahrungslabel",
      "R": "Workflow", "I": ["Antragsteller", "Einkauf"],
      "output": "Freigegebene BANF" },

    { "n": "7", "type": "activity", "text": "Bestellung beim Lieferanten auslösen",
      "R": "Einkauf", "I": "Antragsteller",
      "output": "Bestellung" },

    { "n": "8", "type": "activity", "text": "Monatlicher Export und Erfassung in proAlpha",
      "input": "BANF-Portal, Export Buchhaltung",
      "R": "SS Acc.",
      "output": "CSV, Exportprotokoll" },

    { "type": "end", "text": "Ende" }
  ]
}
